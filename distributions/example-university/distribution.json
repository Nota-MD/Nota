{
  "schemaVersion": 1,
  "kind": "organization",
  "id": "example-university",
  "identity": {
    "name": "Example University",
    "productName": "Nota for Example University",
    "binaryName": "nota-example-university",
    "identifier": "edu.example.university.nota",
    "publisher": "Example University",
    "website": "https://example.edu/",
    "supportUrl": "https://example.edu/support",
    "dataDirectory": "nota-example-university"
  },
  "branding": {
