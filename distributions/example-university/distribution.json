      "zh-CN": "assets/notice-zh-CN.html"
    }
  },
  "updates": {
    "manifestUrl": null,
    "releasePrefix": null,
    "releasePage": null
  },
  "onboarding": {
    "mode": "before-default",
    "guide": {
      "en": "assets/onboarding-en.html",
      "zh-CN": "assets/onboarding-zh-CN.html"
    },
    "fallbackLocale": "en",
    "title": {
      "en": "Welcome to Nota for Example University",
      "zh-CN": "欢迎使用 Example University 版 Nota"
